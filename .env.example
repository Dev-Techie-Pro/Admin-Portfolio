# ─── Required for deployment (host environment only) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portfolio site origin(s) allowed to call /api/public/* (comma-separated, no trailing slashes)
# PORTFOLIO_PUBLIC_ORIGINS=https://example.com,https://www.example.com

# Bearer token for /api/cron/purge-activities and /api/cron/prune-sessions (deployment only — not in admin UI)
CRON_SECRET=
